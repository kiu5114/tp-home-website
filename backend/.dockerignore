# =====================================================================
# TP 全屋家居 · 后端 .dockerignore
# ---------------------------------------------------------------------
# 功能：构建 Docker 镜像时排除无关/大体积文件，减小镜像体积并避免
#       把本地虚拟环境与运行时数据带入镜像。
# =====================================================================

# 本地虚拟环境（镜像内会重新安装依赖）
venv/

# 运行时数据（数据库与上传文件由数据卷挂载，不应打入镜像）
tp_home.db
*.db
uploads/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 日志与本地杂项
*.log
.DS_Store
